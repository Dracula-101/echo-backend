# Service Configuration
APP_ENV=development
CONFIG_PATH=configs/config.yaml

# Server Configuration
SERVER_PORT=8087
SERVER_HOST=0.0.0.0

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=echo
DB_PASSWORD=echo123
DB_NAME=echo_db
DB_SSL_MODE=disable

# Cache Configuration
CACHE_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WebSocket Configuration
WS_WRITE_WAIT=10s
WS_PONG_WAIT=60s
WS_PING_PERIOD=54s
WS_CLEANUP_INTERVAL=30s
WS_STALE_CONNECTION_TIMEOUT=90s

# Kafka Configuration (Producer + Consumer)
KAFKA_BROKERS=localhost:9092
# Producer
KAFKA_PRODUCER_CLIENT_ID=ws-service-producer
KAFKA_COMPRESSION=snappy
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_MAX_IN_FLIGHT=5
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF=100ms
KAFKA_DIAL_TIMEOUT=10s
# Consumer
KAFKA_CONSUMER_CLIENT_ID=ws-service
KAFKA_TOPIC=chat-messages
KAFKA_GROUP_ID=ws-service-delivery-group
KAFKA_SESSION_TIMEOUT=10s
KAFKA_HEARTBEAT_INTERVAL=3s

# Logging
LOG_LEVEL=debug
LOG_FORMAT=console
