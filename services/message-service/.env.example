######################################################################
# Echo Message Service - Environment Variables
# Standardized for consistency with main .env and docker-compose.yml
######################################################################

# General
ENVIRONMENT=development
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=console
CONFIG_PATH=./configs/config.yaml

# =====================
# Server
# =====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8083
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_MAX_HEADER_BYTES=1048576

# =====================
# Database
# =====================
DB_HOST=postgres
DB_PORT=5432
DB_USER=echo
DB_PASSWORD=echo_password
DB_NAME=echo_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =====================
# Redis
# =====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s

# =====================
# Kafka (Producer + Consumer)
# =====================
KAFKA_BROKERS=kafka:9092
# Producer
KAFKA_PRODUCER_CLIENT_ID=message-service-producer
KAFKA_TOPIC=chat-messages
KAFKA_COMPRESSION=snappy
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=10
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_MAX_IN_FLIGHT=5
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_BACKOFF=100ms
KAFKA_DIAL_TIMEOUT=10s
# Consumer (chat messages)
KAFKA_CONSUMER_CLIENT_ID=message-service-consumer
KAFKA_GROUP_ID=message-service-consumer-group
KAFKA_SESSION_TIMEOUT=10s
KAFKA_HEARTBEAT_INTERVAL=3s
# Delivery consumer (delivery events)
KAFKA_DELIVERY_CLIENT_ID=message-service-delivery-consumer
KAFKA_DELIVERY_TOPIC=delivery-events
KAFKA_DELIVERY_GROUP_ID=message-service-delivery-group

# =====================
# WebSocket
# =====================
WS_ENABLED=true
WS_PATH=/ws
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_WRITE_WAIT=10s
WS_PONG_WAIT=60s
WS_PING_PERIOD=54s
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s

# WebSocket Configuration
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_WRITE_WAIT=10s
WS_PONG_WAIT=60s
WS_PING_PERIOD=54s
WS_MAX_MESSAGE_SIZE=10485760
WS_CLIENT_BUFFER_SIZE=256

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT_PATH=stdout
