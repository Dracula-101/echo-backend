# Git
.git
.gitignore
.gitattributes

# Claude / agent worktrees — these alone are hundreds of MB each
.claude/

# Local data + DB dumps — never wanted in any build
data/
db-dump.sql
*.dump
*.sql.gz

# Per-service .env files (gitignored anyway, never wanted in image)
**/.env
**/.env.*

# Compose files don't need to live inside the builder
infra/docker/docker-compose*.yml

# Deploy scripts and runbook
deploy/

# Documentation
*.md
README.md
docs/
.vscode/
.idea/

# Build artifacts
**/bin/
**/dist/
**/*.exe
**/*.dll
**/*.so
**/*.dylib

# Test files
**/*_test.go
**/test/
**/tests/
**/testdata/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Environment files (except the ones we explicitly copy)
.env
.env.*
!.env.docker

# Temporary files
*.tmp
*.log
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.iml

# Infra files (not needed in container)
infra/terraform/
infra/kubernetes/
infra/scripts/

# Migration files (handled separately)
migrations/

# Database files
database/
