######################################################################
# Echo Backend — production env.
#
# Copy to `.env.prod` and fill secrets. Same file is consumed by:
#   - docker-compose.prod.yml         (real VM deploy)
#   - docker-compose.prod-local.yml   (local mirror of prod stack)
#
# Generate strong secrets:
#   openssl rand -base64 48 | tr -d '\n='
######################################################################

# ---------------------------------------------------------------------
# Image registry / version
# ---------------------------------------------------------------------
# IMAGE_REGISTRY = the GHCR namespace your images are pushed to.
# IMAGE_TAG selects which build the VM should run. CI sets this to the
# commit SHA on every deploy; locally `latest` is fine.
# PULL_POLICY = always (default) on the VM, missing on the laptop.
IMAGE_REGISTRY=ghcr.io/echo-backend/echo-backend
IMAGE_TAG=latest
PULL_POLICY=always

# ---------------------------------------------------------------------
# Public hostname (Caddy)
#   - "api.example.com"  → automatic HTTPS via Let's Encrypt.
#   - ":80"              → plain HTTP only. Use for first-boot validation
#                          or when no domain is wired up yet.
# Caddy refuses to start if DOMAIN is empty.
# ---------------------------------------------------------------------
DOMAIN=:80
ACME_EMAIL=

TZ=UTC

# =====================================================================
# PostgreSQL
# =====================================================================
POSTGRES_USER=echo
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=echo_db

# DB_* duplicates POSTGRES_* so service configs picking up DB_USER /
# DB_PASSWORD / DB_NAME also work. They MUST match POSTGRES_*.
DB_HOST=postgres
DB_PORT=5432
DB_USER=echo
DB_PASSWORD=CHANGE_ME_strong_random
DB_NAME=echo_db
# Same VM, internal network only → disable. Set `require` if you front
# Postgres with TLS or expose it across hosts.
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME=300s

# Postgres tuning — defaults work for ~2 GB RAM. Bump on bigger VMs.
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=256MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_MAX_CONNECTIONS=100
PG_LOG_MIN_DURATION_MS=500

# =====================================================================
# Redis
# =====================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_random
REDIS_MAX_MEMORY=256mb

# =====================================================================
# Kafka / Zookeeper
# =====================================================================
KAFKA_BROKERS=kafka:29092
KAFKA_NUM_PARTITIONS=8
KAFKA_LOG_RETENTION_HOURS=72
KAFKA_HEAP_OPTS=-Xmx384m -Xms256m
ZK_HEAP_OPTS=-Xmx128m -Xms96m

# =====================================================================
# Meilisearch (in-docker, used by user-service for search)
# Generate with: openssl rand -base64 32 | tr -d '/+=' | head -c 32
# =====================================================================
MEILI_MASTER_KEY=CHANGE_ME_meilisearch_master_key

# =====================================================================
# JWT (auth-service + api-gateway)
# =====================================================================
# Generate with: openssl rand -base64 64 | tr -d '\n='
JWT_SECRET_KEY=CHANGE_ME_long_random_at_least_64_bytes
JWT_ISSUER=echo-auth-service
JWT_AUDIENCE=echo-users
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_LEEWAY=1m

# =====================================================================
# Email — Mailgun (auth-service: verification + password reset emails)
# Set EMAIL_ENABLED=true and fill MAILGUN_* to enable.
# =====================================================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=mailgun
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_BASE_URL=https://api.mailgun.net/v3
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_TOKEN_TTL=24h
EMAIL_VERIFICATION_RESEND_COOLDOWN=1m

# =====================================================================
# SMS — Twilio (auth-service: phone verification, optional)
# Disabled by default. The service config defaults to enabled, so we
# explicitly turn it off here to avoid startup errors with empty creds.
# =====================================================================
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# =====================================================================
# OAuth providers (auth-service, optional social login)
# =====================================================================
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# =====================================================================
# Push notifications — Firebase (auth-service, REQUIRED)
# auth-service refuses to start without a valid credentials file. Path
# is INSIDE the container. The file itself is written to the VM by the
# deploy workflow from the FIREBASE_CREDENTIALS_JSON GitHub secret
# (base64-encoded Firebase service-account JSON).
# =====================================================================
FIREBASE_CREDENTIALS_FILE=/etc/firebase/credentials.json

# =====================================================================
# Feature flags
# =====================================================================
VIRUS_SCAN_ENABLED=false

# =====================================================================
# CORS / WebSocket origins
# =====================================================================
# Comma-separated. For wildcard `*`, set CORS_ALLOW_CREDENTIALS=false.
CORS_ALLOWED_ORIGINS=https://your-frontend.example
CORS_ALLOW_CREDENTIALS=true
WS_ALLOWED_ORIGINS=https://your-frontend.example
WS_MAX_CONNECTIONS=2000

RATE_LIMIT_RPM=6000
RATE_LIMIT_BURST=200

# =====================================================================
# Cloudflare R2 (used by media-service)
#
# R2 is S3-compatible. The variable names below are what media-service
# reads (STORAGE_*), but the values come from your Cloudflare R2 bucket.
# Find them at: Cloudflare dashboard → R2 → API Tokens → Manage Tokens.
#
# Region must be `auto` — R2 has no regions.
# Endpoint is `https://<account-id>.r2.cloudflarestorage.com`.
# Public URL is the public bucket URL (e.g., pub-<id>.r2.dev or your
# custom domain bound to the bucket).
# =====================================================================
STORAGE_PROVIDER=r2
STORAGE_BUCKET=echo-media
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# =====================================================================
# Go runtime
# =====================================================================
GOMAXPROCS=2
GOGC=100
GOMEMLIMIT=192MiB

# =====================================================================
# Observability
# =====================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =====================================================================
# Container resource budgets.
#
# Defaults work on a small VM (~2 GB total RAM). To scale up, raise the
# numbers — no compose file edits needed. Reservations are advisory; only
# the limits hard-cap the cgroup.
#
# All sizes accept docker units: 256M, 1G, 0.5 (cpus), etc.
# =====================================================================
RES_GO_CPUS=1.0
RES_GO_MEMORY=256M
RES_GO_CPUS_RESERVED=0.05
RES_GO_MEMORY_RESERVED=64M

RES_POSTGRES_CPUS=2.0
RES_POSTGRES_MEMORY=512M
RES_POSTGRES_CPUS_RESERVED=0.25
RES_POSTGRES_MEMORY_RESERVED=256M

RES_REDIS_CPUS=1.0
RES_REDIS_MEMORY=256M
RES_REDIS_CPUS_RESERVED=0.05
RES_REDIS_MEMORY_RESERVED=64M

RES_KAFKA_CPUS=2.0
RES_KAFKA_MEMORY=768M
RES_KAFKA_CPUS_RESERVED=0.25
RES_KAFKA_MEMORY_RESERVED=384M

RES_ZOOKEEPER_CPUS=0.5
RES_ZOOKEEPER_MEMORY=256M
RES_ZOOKEEPER_CPUS_RESERVED=0.05
RES_ZOOKEEPER_MEMORY_RESERVED=128M

RES_CADDY_CPUS=0.5
RES_CADDY_MEMORY=128M
RES_CADDY_CPUS_RESERVED=0.05
RES_CADDY_MEMORY_RESERVED=32M

# =====================================================================
# Backups (read by infra/scripts/backup-postgres.sh)
# =====================================================================
BACKUP_DIR=/var/backups/echo
BACKUP_RETENTION_DAYS=14
# Optional: set ONE of these to ship dumps off-box automatically.
#   gs://my-bucket/echo-backups/         (uses gsutil)
#   s3://my-bucket/echo-backups/         (uses aws s3)
BACKUP_REMOTE_URL=
