# Public reverse proxy for the echo-backend stack.
#
# DOMAIN values:
#   - "api.example.com"  → HTTPS. If /etc/caddy/certs/cert.pem exists,
#                          Caddy uses that pair (e.g. Cloudflare Origin
#                          Certificate). Otherwise it falls back to
#                          Let's Encrypt via ACME.
#   - ":80"              → plain HTTP on every host (no TLS). Useful for
#                          first-boot validation against the raw VM IP.
#
# Caddy doesn't support default values in env-var substitution, so .env.prod
# MUST set DOMAIN to one of the two forms above. The example file ships
# with `DOMAIN=:80` so a fresh deploy works without a domain configured.

{
	# We're using Cloudflare Origin Certs (see the `tls` line below), not
	# ACME, so no `email` directive is needed. To switch back to Let's
	# Encrypt, add `email {$ACME_EMAIL}` here AND ensure ACME_EMAIL is
	# set in .env.prod (Caddy refuses to parse a bare `email` directive).
	admin localhost:2019
	servers {
		# Trust X-Forwarded-* only from private upstream proxies (Cloudflare
		# proxies → VM connection traverses the public internet, but CF's
		# IPs are in the trusted_proxies list when needed).
		trusted_proxies static private_ranges
	}
}

# Reusable header snippet — modern browser hardening.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=()"
		# Strip Caddy's banner.
		-Server
	}
}

(common_proxy) {
	# Caddy passes X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host
	# automatically, so we only set X-Real-IP explicitly.
	header_up X-Real-IP {remote_host}
	# Conservative timeouts so a slow upstream can't exhaust connections.
	transport http {
		dial_timeout       5s
		response_header_timeout 30s
		read_timeout       300s
	}
}

{$DOMAIN} {
	encode zstd gzip
	import security_headers

	# Use the Cloudflare Origin Cert (or any PEM pair). Files are mounted
	# read-only via docker-compose.prod.yml from /opt/echo-backend/secrets.
	# Caddy will refuse to start if these are missing — which is the
	# behavior we want in production. To switch back to Let's Encrypt,
	# delete this `tls` line and Caddy reverts to automatic ACME.
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

	# Caddy's own health endpoint (used by the container healthcheck).
	handle /caddy-health {
		respond "ok" 200
	}

	# WebSocket. Caddy detects the Upgrade header and keeps the connection
	# long-lived; the read_timeout above is overridden for upgraded conns.
	handle /ws* {
		reverse_proxy ws-service:8086 {
			import common_proxy
		}
	}

	# Everything else → api-gateway.
	handle {
		reverse_proxy api-gateway:8080 {
			import common_proxy
		}
	}

	log {
		output stdout
		format json
		level INFO
	}
}
